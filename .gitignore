node_modules/
*.log
npm-debug.log*

# Local Home Packs. A pack describes where someone actually lives, so packs
# other than the fictional example are kept out of the repository by default.
/homes/
/packs/
*.private.json
*.domoview.local.json

# Build output is committed on purpose (HACS installs dist/domoview.js
# directly), so only the sourcemaps are ignored.
dist/**/*.map

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Scratch
/tmp/
/scratch/
*.blend1
