{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/tomjschr/DomoView/main/schemas/ai-task-graph-1.schema.json",
  "title": "DomoView AI Task Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agent", "instruction", "dependsOn", "reads", "writes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "agent": { "enum": ["fixture", "geometry", "appearance", "binding"] },
          "instruction": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
          },
          "reads": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/resource" }
          },
          "writes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/resource" }
          }
        }
      }
    }
  },
  "definitions": {
    "resource": {
      "type": "string",
      "pattern": "^(fixtures|walls|openings|rooms|materials|environment|bindings)(:[a-zA-Z0-9_*_-]+)?$"
    }
  }
}
